# WorkFlowOS secrets — copy to .env and fill in.
# .env is gitignored. Do NOT paste these values into chat or commit them.

# ---------------------------------------------------------------------------
# LLM (optional) — free tiers, no card required.
# Without a key, workflow generation uses the local deterministic template,
# which is still runtime-variable driven and works on real emails.
# ---------------------------------------------------------------------------
# Primary: Groq  -> https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-8b-8192

# Backup: OpenRouter free tier -> https://openrouter.ai/keys
# Switch by changing these two lines only (no code change, no restart of Go needed
# beyond restarting the process):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3-8b-instruct:free

# ---------------------------------------------------------------------------
# Slack (required for real Slack messages)
# https://api.slack.com/apps -> From scratch -> Incoming Webhooks
#   -> Activate -> Add New Webhook to Workspace -> pick a channel -> Allow
# Verify with:  python doctor.py --slack
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Gmail OAuth (required for real email processing)
# credentials.json = the OAuth 2.0 Desktop client JSON from Google Cloud.
# token.json       = created automatically on first authorized run.
# Both are gitignored. See SETUP.md step 3.
# ---------------------------------------------------------------------------
GMAIL_CREDENTIALS=./python/credentials.json
GMAIL_TOKEN=./python/token.json

# ---------------------------------------------------------------------------
# Local wiring (defaults are usually fine)
# ---------------------------------------------------------------------------
CRM_URL=http://localhost:8080
DOWNLOAD_DIR=./python/downloads
PYTHON_EXECUTOR_URL=http://localhost:8082
PYTHON_EXECUTOR_PORT=8082
PORT=8080

# Set to false for a real run against Gmail and Slack.
DEMO_MODE=true
DRY_RUN=false
